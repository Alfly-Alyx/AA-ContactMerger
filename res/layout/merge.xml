<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/merge_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
>

    <!-- layout for dummy text + list -->
    <ViewSwitcher
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >

    <FrameLayout
        android:id="@+id/welcome_screen"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
    >

        <LinearLayout
            android:id="@+id/analysis_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/load_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textSize="20sp"
                android:gravity="center"
                android:lines="3" />

            <LinearLayout
                android:id="@+id/progress_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/analyze_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:maxHeight="12dp"
                    android:minHeight="12dp"
                    android:padding="0dp"
                    android:progressDrawable="@drawable/analysis_progress" />

                <TextView
                    android:id="@+id/stop_scan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/progress_stop_background"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:minWidth="40dp"
                    android:padding="0dp"
                    android:tag="remove"
                    android:text="@string/fa_times"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/start_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="220dp"
            android:text="@string/analyze_now" />

        <LinearLayout
            android:id="@+id/welcome_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans"
                android:text="@string/app_name"
                android:textColor="@color/heading_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <ViewSwitcher
        android:id="@+id/switcher_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

    <!-- List -->
    <ListView
        android:id="@+id/contact_merge_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dip"
        android:background="@color/surface_background"
        android:paddingBottom="2dip"
    />

    <!-- Empty analysis result -->
    <LinearLayout
        android:id="@+id/all_done"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:paddingTop="18dp"
            android:gravity="center"
            android:lines="2"
            android:text="@string/contact_list_clean"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans"
                android:text="@string/app_name"
                android:textColor="@color/heading_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    </ViewSwitcher>
    </ViewSwitcher>

</LinearLayout>
